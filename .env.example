# ==========================================
# 应用基础配置
# ==========================================
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=flowgenall

# ==========================================
# Redis 缓存配置
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT 认证配置
# ==========================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# 密码加密配置
# ==========================================
BCRYPT_SALT_ROUNDS=10

# ==========================================
# 文件上传配置
# ==========================================
# 最大文件大小（字节，默认 50MB）
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads
# 允许的文件类型
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/markdown

# ==========================================
# 阿里云 DashScope (通义千问 AI)
# ==========================================
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 默认使用的模型 (qwen-plus | qwen-max | qwen-vl-plus)
DEFAULT_QWEN_MODEL=qwen-plus
# 最大上下文长度
QWEN_MAX_CONTEXT_LENGTH=32000
# AI 调用超时时间(毫秒)
AI_REQUEST_TIMEOUT=60000
# 按模型配置缓存TTL(秒) - 成本驱动策略
AI_CACHE_TTL_QWEN_PLUS=1800      # 30分钟(成本低)
AI_CACHE_TTL_QWEN_MAX=7200       # 2小时(成本高)
AI_CACHE_TTL_QWEN_VL=3600        # 1小时(中等成本)

# ==========================================
# 阿里云 OCR (文字识别)
# ==========================================
# 获取地址: https://ram.console.aliyun.com/manage/ak
ALIYUN_ACCESS_KEY_ID=LTAI5txxxxxxxxxxxxxxxx
ALIYUN_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALIYUN_OCR_ENDPOINT=ocr.cn-shanghai.aliyuncs.com

# ==========================================
# 阿里云 OSS (对象存储)
# ==========================================
# Bucket 创建地址: https://oss.console.aliyun.com/bucket
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=flowgenall-files
OSS_ACCESS_KEY_ID=LTAI5txxxxxxxxxxxxxxxx
OSS_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 文件自动过期时间（小时）
OSS_FILE_EXPIRY_HOURS=24

# ==========================================
# 阿里云通义万相 (图像生成 - 可选)
# ==========================================
TONGYI_WANXIANG_API_KEY=

# ==========================================
# MinIO (本地对象存储 - 可选，用于开发环境)
# ==========================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=flowgenall
MINIO_USE_SSL=false

# ==========================================
# 第三方搜索服务 (外部数据聚合模块)
# ==========================================
# 百度AI搜索 API Key
# 获取地址: https://console.bce.baidu.com/qianfan/ais/console/applicationConsole/application
# 每日免费额度：100次，每日最大调用：100,000次
BAIDU_SEARCH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 搜索缓存配置
SEARCH_CACHE_TTL=3600

# GitHub API Token (可选，用于搜索 GitHub 资源)
# 获取地址: https://github.com/settings/tokens
GITHUB_TOKEN=

# ==========================================
# 队列配置 (BullMQ)
# ==========================================
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

# ==========================================
# 安全配置
# ==========================================
# CORS 允许的源（前端地址）
CORS_ORIGIN=http://localhost:5173
# 阿里云内容安全 (可选)
ALIYUN_CONTENT_SECURITY_ENABLED=false

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=info
